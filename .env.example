# AI product photography, used only by `npm run generate:images` at build time.
# These are NOT VITE_ variables on purpose: nothing in the browser bundle may
# ever see them. Set them in your shell, not in .env.local, so they cannot be
# committed by accident:
#
#   $env:OPENAI_API_KEY = "sk-..."
#   $env:IMAGE_PROVIDER = "openai"        # openai | stability
#   $env:IMAGE_MODEL    = "gpt-image-1"  # optional, provider default otherwise
#
# For an OpenAI-compatible server (a proxy, or local Ollama / LM Studio):
#   $env:IMAGE_ENDPOINT = "http://localhost:11434/v1/images/generations"
#
# For Stability instead:
#   $env:IMAGE_PROVIDER    = "stability"
#   $env:STABILITY_API_KEY = "sk-..."
